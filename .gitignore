# macOS
.DS_Store

# 비밀값: OTA 서명 키는 절대 커밋하지 않는다 (책 1.4.9절). 폴더는 .gitkeep으로 남긴다
certificates/*.pem
*.pem

# ESP-IDF 빌드 결과
firmware/build/
firmware/sdkconfig
firmware/sdkconfig.old
firmware/managed_components/

# Flutter 빌드 결과 (그 밖의 항목은 flutter/.gitignore)
flutter/build/

# 릴리즈 빌드 결과물 (scripts/build-flutter-release.sh)
releases/

# 도구 상태
.bkit/

# 개인 설정: 저장소에 넣지 않는다 (책 2장)
.claude/settings.local.json
.claude/worktrees/
.vscode/
.idea/
*.swp
Thumbs.db

# Android 서명·로컬 설정 (스토어 배포용 키를 만들었을 때 대비)
flutter/android/key.properties
flutter/android/local.properties
*.jks
*.keystore

# 환경 변수·비밀값 파일
.env
.env.*
